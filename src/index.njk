<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover"
    />
    <meta name="theme-color" content="#ffffff" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta
      name="apple-mobile-web-app-status-bar-style"
      content="default"
    />
    <meta name="apple-mobile-web-app-title" content="Vector" />
    <meta
      http-equiv="Cache-Control"
      content="no-cache, no-store, must-revalidate"
    />
    <meta http-equiv="Pragma" content="no-cache" />
    <meta http-equiv="Expires" content="0" />
    <title>Vector — SVG Artwork & Plotter Studio</title>

    <link
      rel="icon"
      type="image/svg+xml"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'%3E%3Cpath d='M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E"
    />

    <link rel="stylesheet" href="css/app.css" />
    <link rel="stylesheet" href="css/components.css" />
    <link rel="stylesheet" href="css/viewer.css" />
  </head>
  <body>
    <div id="app-container">
      <!-- Main Content Wrapper (Full-width clean layout) -->
      <main class="content-wrapper">
        <!-- Top Header -->
        <header class="app-header">
          <div class="brand">
            <div class="brand-icon">
              <svg
                data-lucide="star"
                viewBox="0 0 24 24"
                width="24"
                height="24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              ></svg>
            </div>
            <span>Vector</span>
          </div>

          <div class="header-actions">
            <button
              id="grid-mode-btn"
              class="header-action-btn"
              title="Toggle 3-grid gallery mode (1:1 preview only)"
              aria-label="Toggle 3-grid gallery mode"
              aria-pressed="false"
            >
              <svg
                class="icon-gallery-view"
                data-lucide="grid-3x3"
                viewBox="0 0 24 24"
                width="18"
                height="18"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              ></svg>
              <svg
                class="icon-standard-view"
                data-lucide="grid-2x2"
                viewBox="0 0 24 24"
                width="18"
                height="18"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              ></svg>
            </button>
          </div>
        </header>

        <!-- Search Section with Integrated Category Dropdown -->
        <section class="search-filter-section">
          <div class="search-input-wrapper">
            <svg
              class="search-icon"
              data-lucide="search"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            ></svg>
            <input
              type="text"
              id="search-input"
              class="search-input"
              placeholder="Search vector illustrations..."
              autocomplete="off"
              autocorrect="off"
              autocapitalize="off"
            />
            <button
              id="search-clear-btn"
              class="search-clear-btn"
              title="Clear search"
            >
              <svg
                viewBox="0 0 24 24"
                width="16"
                height="16"
                data-lucide="x"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              ></svg>
            </button>

            <div class="search-divider"></div>

            <!-- Category Dropdown on the right -->
            <div
              class="category-dropdown-wrapper"
              id="category-dropdown-wrapper"
            >
              <button
                type="button"
                class="category-dropdown-btn"
                id="category-dropdown-btn"
                aria-haspopup="listbox"
                aria-expanded="false"
                title="Filter by Category"
              >
                <span class="category-current-label" id="category-current-label"
                  >All Artworks</span
                >
                <svg
                  class="dropdown-chevron"
                  viewBox="0 0 24 24"
                  width="12"
                  height="12"
                  data-lucide="chevron-down"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                ></svg>
              </button>
              <div
                class="category-dropdown-menu"
                id="category-dropdown-menu"
                role="listbox"
              >
                <!-- Dynamically populated category items -->
              </div>
            </div>
          </div>
        </section>

        <!-- Main Scrollable Grid Area -->
        <div class="main-viewport" id="main-viewport">
          <div class="svg-grid" id="svg-grid">
            <!-- Dynamic SVG Artwork cards rendered here -->
          </div>

          <div
            class="empty-state"
            id="empty-state"
            style="display: none;"
          >
            <div class="empty-state-icon">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                data-lucide="search"
              ></svg>
            </div>
            <h3>No Artworks Found</h3>
            <p>Try searching for another style or term.</p>
          </div>
        </div>

        <!-- Pagination -->
        <div class="pagination" id="pagination" style="display: none;">
          <div class="pagination-info" id="pagination-info"
            >Showing <span id="pagination-start">1</span>-<span id="pagination-end">40</span> of <span id="pagination-total">0</span> artworks
          </div>
          <div class="pagination-controls" id="pagination-controls"></div>
        </div>
      </main>
    </div>

    <!-- Fullscreen Artwork Preview Overlay -->
    <div
      id="fullscreen-overlay"
      class="fullscreen-overlay"
      style="display: none;"
      role="dialog"
      aria-modal="true"
      aria-label="Fullscreen artwork preview"
    >
      <div class="fullscreen-content">
        <div class="fullscreen-svg-container" id="fullscreen-svg-container"></div>
      </div>
    </div>

    <!-- Artwork Info / License & Specifications Modal -->
    <div
      id="info-modal"
      class="info-modal"
      style="display: none;"
      role="dialog"
      aria-modal="true"
      aria-label="Artwork details"
    >
      <div class="info-modal-container">
        <div class="info-modal-drag-handle" aria-hidden="true"></div>
        <button
          class="info-modal-close"
          id="info-modal-close"
          title="Close"
          aria-label="Close details"
        >
          <svg
            viewBox="0 0 24 24"
            width="18"
            height="18"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
        <div class="info-modal-content" id="info-modal-content"></div>
      </div>
    </div>

    <!-- Share Link Toast -->
    <div id="share-toast" class="share-toast" style="display: none;">
      Link copied to clipboard
    </div>

    <!-- Application Scripts (loaded in order — no ES modules, works with file://) -->
    <script src="js/vendor/lucide.min.js"></script>
    <script src="js/lib/svg-library-core.js"></script>
    {% for cat in svgs.categories %}
    <script src="js/lib/{{ cat.slug }}.js"></script>
    {% endfor %}
    <script src="js/storage.js"></script>
    <script src="js/export.js"></script>
    <script src="js/viewer.js"></script>
    <script src="js/library.js"></script>
    <script src="js/app.js"></script>
  </body>
</html>
