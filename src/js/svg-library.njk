// Auto-generated SVG library bundle — do not edit by hand
// Generated by Eleventy — works with file:// — no server needed

(function() {
  'use strict';

  window.svgLibrary = {
    categories: {{ categories | dump(2) }},
    svgs: [
{% for svg in svgs %}
      {
        id: {{ svg.id | dump }},
        name: {{ svg.name | dump }},
        path: {{ svg.path | dump }},
        displayName: {{ svg.displayName | dump }},
        category: {{ svg.category | dump }},
        categorySlug: {{ svg.categorySlug | dump }},
        size: {{ svg.size }},
        mtime: {{ svg.mtime }},
        {% if svg.content is defined %}content: {{ svg.content | dump }},{% endif %}
        {% if svg.isSprite is defined %}isSprite: {{ svg.isSprite }},{% endif %}
        {% if svg.spriteFile is defined %}spriteFile: {{ svg.spriteFile | dump }},{% endif %}
        {% if svg.symbolId is defined %}symbolId: {{ svg.symbolId | dump }},{% endif %}
      }{% if not loop.last %},{% endif %}
{% endfor %}
    ]
  };
})();
